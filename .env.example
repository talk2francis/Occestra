# Occestra environment — copy to .env and fill. NEVER commit .env.
OCE_PAYMENT_MODE=dev            # dev | okx
OCE_TREASURY=                   # required in prod: address that receives USDT settlement
OCE_SEALER_KEY=                 # secret, prod: private key that signs EIP-712 seals + calls KeepsakeRegistry
OCE_REGISTRY=                   # KeepsakeRegistry contract address (set after deploy)
OCE_CHAIN_ID=196                # X Layer mainnet
OCE_RPC_URL=https://rpc.xlayer.tech
OCE_PUBLIC_BASE_URL=https://occestra.xyz
OCE_DAILY_IMAGE_CAP=120
OCE_DAILY_LLM_USD_CAP=15
PORT=8402

# Models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional grounding providers
OCE_PLACES_KEY=

# OKX Developer Platform (OnchainOS / Payment SDK)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# --- GenLayer consensus review (optional) ------------------------------------
# Unset GENLAYER_NETWORK and Occestra runs exactly as before: no consensus, no errors.
# bradbury and asimov are the SAME chain (id 4221) under two names; asimov is current.
GENLAYER_NETWORK=bradbury
GENLAYER_RPC_URL=
# Set after deploying the adjudicator. Reads work with just this; no key needed.
GENLAYER_QUALITY_CONTRACT_ADDRESS=
# SERVER ONLY. A dedicated, funded Bradbury wallet — never the X Layer sealer, the OKX
# treasury, or the registry deployer. Separate credential, separate trust domain.
# Never expose as NEXT_PUBLIC_* (the config loader refuses to start if you do).
GENLAYER_SUBMITTER_PRIVATE_KEY=
